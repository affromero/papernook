#!/usr/bin/env bash
# papernook command line: update the clone to a newer release and report
# what the stack is running. Installed on PATH by scripts/install.sh as a
# wrapper that execs this file inside the clone.

set -euo pipefail

# Everything lives inside braces so bash parses the whole file before running
# any of it. An update rewrites this script while it executes, and bash
# otherwise resumes reading the file at a byte offset that now lands in the
# middle of different code.
{

cd "$(dirname "$0")/.."
[ -f docker-compose.yml ] || {
  echo "papernook: run this from inside the papernook clone" >&2
  exit 1
}

usage() {
  cat <<'USAGE'
papernook — self-hosted paper library

  papernook update [--check] [--main] [--no-backup]
      Move the clone to the newest release tag and rebuild the stack.
      --check      report what an update would do, change nothing
      --main       track the main branch instead of release tags
      --no-backup  skip the pre-update backup (scripts/backup.sh)

  papernook status
      Show the running version, whether a newer release exists, and health.

  papernook link [--bin-dir DIR]
      (Re)install the `papernook` command on PATH, pointing at this clone.
      Run by scripts/install.sh; run it by hand after moving the clone.

  papernook help
USAGE
}

# The health endpoint answers on the port compose published, which .env may
# override. Sourcing the file would leak secrets into this process, so read
# only the two keys that matter.
app_url() {
  local host port
  host=$(sed -n 's/^APP_HOST=//p' .env 2>/dev/null | tail -1 | tr -d '"'"'"'')
  port=$(sed -n 's/^APP_PORT=//p' .env 2>/dev/null | tail -1 | tr -d '"'"'"'')
  case "${host:-127.0.0.1}" in
    "" | 0.0.0.0) host=127.0.0.1 ;;
  esac
  echo "http://${host:-127.0.0.1}:${port:-3000}"
}

health() {
  curl -fsS --max-time 5 "$(app_url)/api/v1/health" 2>/dev/null
}

current_ref() {
  git describe --tags --exact-match 2>/dev/null ||
    git symbolic-ref -q --short HEAD ||
    git rev-parse --short HEAD
}

latest_tag() {
  git tag --list 'v*' --sort=-v:refname | head -1
}

# Newest release, or the tracked branch tip with --main. Empty means the
# remote offers nothing to move to.
target_ref() {
  if [ "$TRACK_MAIN" = "1" ]; then
    echo "origin/main"
  else
    latest_tag
  fi
}

# True when the checkout already contains the release, which is how a clone
# that follows main looks: the newest tag is behind it, not ahead.
ahead_of_releases() {
  git merge-base --is-ancestor "$1" HEAD 2>/dev/null
}

cmd_status() {
  git fetch --tags --force --prune origin >/dev/null 2>&1 ||
    echo "papernook: could not reach origin; reporting local state only" >&2
  echo "clone:    $(pwd)"
  echo "checkout: $(current_ref) ($(git rev-parse --short HEAD))"
  local latest
  latest=$(latest_tag)
  if [ -z "$latest" ]; then
    echo "release:  none published"
  elif [ "$(git rev-parse "$latest")" = "$(git rev-parse HEAD)" ]; then
    echo "release:  ${latest} (current)"
  elif ahead_of_releases "$latest"; then
    echo "release:  ${latest} — this checkout already runs newer code"
  else
    echo "release:  ${latest} available — run 'papernook update'"
  fi
  local response
  if response=$(health); then
    echo "health:   ${response}"
  else
    echo "health:   unreachable at $(app_url)"
  fi
}

# A generated wrapper rather than a symlink: the clone path is baked in, so
# the command works the same however the shell resolves it.
cmd_link() {
  local bin_dir clone
  bin_dir=${BIN_DIR:-${XDG_BIN_HOME:-$HOME/.local/bin}}
  clone=$(pwd)
  mkdir -p "$bin_dir"
  cat > "$bin_dir/papernook" <<SHIM
#!/usr/bin/env bash
# Generated by 'papernook link'. Points at the clone it was installed from.
clone="${clone}"
[ -x "\$clone/scripts/papernook" ] || {
  echo "papernook: no clone at \$clone (moved or deleted?)" >&2
  exit 1
}
exec "\$clone/scripts/papernook" "\$@"
SHIM
  chmod 755 "$bin_dir/papernook"
  echo "Installed ${bin_dir}/papernook → ${clone}"
  case ":${PATH}:" in
    *":${bin_dir}:"*) ;;
    *) echo "Add it to your PATH:  export PATH=\"${bin_dir}:\$PATH\"" ;;
  esac
}

# "<package version>+<short sha>", or the sha alone if package.json is
# unreadable — the endpoint must always name something exact.
stack_version() {
  local version commit
  commit=$(git rev-parse --short HEAD)
  version=$(sed -n 's/^  "version": "\(.*\)",$/\1/p' package.json 2>/dev/null | head -1)
  if [ -n "$version" ]; then
    echo "${version}+${commit}"
  else
    echo "$commit"
  fi
}

cmd_update() {
  git diff --quiet && git diff --cached --quiet || {
    echo "papernook: the clone has uncommitted changes; commit or discard them first" >&2
    exit 1
  }
  echo "Fetching…"
  # A --depth 1 install has no history to compare or move through.
  # --force because releases are the remote's to define: a local tag left
  # pointing at a retagged commit otherwise aborts every future update.
  if [ -f "$(git rev-parse --git-dir)/shallow" ]; then
    git fetch --unshallow --tags --force origin
  else
    git fetch --tags --force --prune origin
  fi

  local target
  target=$(target_ref)
  [ -n "$target" ] || {
    echo "papernook: origin has no release tags yet; try --main" >&2
    exit 1
  }
  if [ "$(git rev-parse "$target")" = "$(git rev-parse HEAD)" ]; then
    echo "Already on the newest $([ "$TRACK_MAIN" = 1 ] && echo main || echo release) ($(current_ref))."
    exit 0
  fi
  if [ "$TRACK_MAIN" != "1" ] && ahead_of_releases "$target"; then
    echo "This checkout already runs newer code than ${target}; refusing to move backwards."
    echo "It follows a branch — update it with 'papernook update --main'."
    exit 0
  fi

  echo "Update: $(current_ref) → ${target}"
  git --no-pager log --oneline HEAD.."$target" | head -20
  if [ "$CHECK_ONLY" = "1" ]; then
    echo "(--check: nothing changed)"
    exit 0
  fi

  if [ "$BACKUP" = "1" ] && [ -f .env ]; then
    echo "Backing up…"
    ./scripts/backup.sh
  fi

  # Detached at a tag, or fast-forwarding the branch the user tracks —
  # never a merge, so a diverged clone stops here instead of conflicting.
  if [ "$TRACK_MAIN" = "1" ]; then
    git checkout main
    git merge --ff-only origin/main
  else
    git -c advice.detachedHead=false checkout --detach "$target"
  fi

  echo "Rebuilding…"
  # The health endpoint reports this. Between releases the package version
  # alone is ambiguous, so it carries the commit too: 0.2.0+fc26c3f. Ports
  # and every other setting come from .env, which compose interpolates.
  PAPERNOOK_VERSION=$(stack_version) docker compose up -d --build

  printf 'Waiting for health'
  local response=""
  for _ in $(seq 1 30); do
    if response=$(health); then break; fi
    printf '.'
    sleep 2
  done
  echo
  if [ -n "$response" ]; then
    echo "papernook is up on $(current_ref): ${response}"
  else
    echo "papernook: the stack did not report healthy at $(app_url)" >&2
    echo "  docker compose logs --tail 50 app" >&2
    exit 1
  fi
}

CHECK_ONLY=0
TRACK_MAIN=0
BACKUP=1
BIN_DIR=""
command=${1:-help}
shift || true
while [ $# -gt 0 ]; do
  argument=$1
  shift
  case "$argument" in
    --check) CHECK_ONLY=1 ;;
    --main) TRACK_MAIN=1 ;;
    --no-backup) BACKUP=0 ;;
    --bin-dir)
      BIN_DIR=${1:?--bin-dir needs a directory}
      shift
      ;;
    *)
      echo "papernook: unknown option ${argument}" >&2
      usage >&2
      exit 1
      ;;
  esac
done

case "$command" in
  update) cmd_update ;;
  status) cmd_status ;;
  link) cmd_link ;;
  help | -h | --help) usage ;;
  *)
    echo "papernook: unknown command ${command}" >&2
    usage >&2
    exit 1
    ;;
esac

}
