# Optional: leave AI_PROVIDER unset to run without AI (capture, reading, and
# annotation all work; per-paper chat and discovery stay off until set).
AI_PROVIDER=claude-code
# For Docker CLI providers, set only the selected provider's credential file.
# CODEX_AUTH_FILE=/home/you/.codex/auth.json
# CLAUDE_AUTH_FILE=/home/you/.claude/.credentials.json
# CLAUDE_CODE_MODEL=
# CLAUDE_CODE_OAUTH_TOKEN=  # macOS Docker: generate with `claude setup-token`
# CODEX_MODEL=
# CLAUDE_CODE_SSH_HOST=you@your-vps
# CODEX_SSH_HOST=you@your-vps
# SSH_KEY_FILE=/home/you/.ssh/papernook
# SSH_KNOWN_HOSTS_FILE=/home/you/.ssh/known_hosts
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENAI_MODEL=
# OPENAI_BASE_URL=
# OLLAMA_HOST=http://host.docker.internal:11434
# OLLAMA_MODEL=qwen3:4b
# LLAMACPP_BASE_URL=http://host.docker.internal:8080
# LLAMACPP_MODEL=
# VLLM_BASE_URL=http://host.docker.internal:8000
# VLLM_MODEL=

# Optional environment-managed tldraw production key. The admin can instead
# save a key at runtime from the setup wizard or Settings → Canvas.
# TLDRAW_LICENSE_KEY=

WEBDAV_USER=papers
WEBDAV_PASS=<generate-a-unique-16+-character-password>

# Private Tailscale/LAN access needs no settings below.
#
# For a custom public domain, set all of these and follow
# docs/public-exposure.md:
# PUBLIC_EXPOSURE=true
# PAPERNOOK_PUBLIC_HOST=papernook.example.com
# PAPERNOOK_PASSWORD=<long unique access password>
# SESSION_SECRET=<64 hex chars>
# APP_HOST=127.0.0.1
# WEBDAV_HOST=127.0.0.1
# Required with a custom public domain:
# PAPERNOOK_WEBDAV_URL=https://dav-papernook.example.com

# iCloud share link of the prebuilt capture Shortcut (see docs/shortcut.md)
# PAPERNOOK_SHORTCUT_URL=https://www.icloud.com/shortcuts/...
