# Optional: leave AI_PROVIDER unset to run without AI (capture, reading, and
# annotation all work; per-paper chat and discovery stay off until set).
AI_PROVIDER=claude-code
# Model choice lives in Settings (data/agent-config.json), not env.
# For Docker CLI providers, set only the selected provider's credential
# directory. Papernook can then reload login/logout changes from Settings.
# Set only the provider directories Papernook should be allowed to read.
# CODEX_AUTH_DIR=/home/you/.codex
# CLAUDE_AUTH_DIR=/home/you/.claude
# CLAUDE_CODE_OAUTH_TOKEN=  # macOS Docker: generate with `claude setup-token`
# CLAUDE_CODE_SSH_HOST=you@your-vps
# CODEX_SSH_HOST=you@your-vps
# SSH_KEY_FILE=/home/you/.ssh/papernook
# SSH_KNOWN_HOSTS_FILE=/home/you/.ssh/known_hosts
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=            # only sent to OPENAI_BASE_URL, never to a Settings endpoint
# OPENAI_BASE_URL=
# OPENAI_COMPATIBLE_API_KEY=  # credential for an endpoint set in Settings
# OLLAMA_HOST=http://host.docker.internal:11434
# LLAMACPP_BASE_URL=http://host.docker.internal:8080
# VLLM_BASE_URL=http://host.docker.internal:8000
# WEB_SEARCH_BASE_URL=http://search:8080  # optional custom SearXNG endpoint

# Optional environment-managed tldraw production key. The admin can instead
# save a key at runtime from the setup wizard or Settings → Canvas.
# TLDRAW_LICENSE_KEY=

WEBDAV_USER=papers
WEBDAV_PASS=<generate-a-unique-16+-character-password>

# The instance access password. REQUIRED — it is the only credential
# papernook has, and the container refuses to start without it. Everyone who
# knows it can pick any profile, so treat it as a household secret.
PAPERNOOK_PASSWORD=<long unique access password>
#
# Ports bind to 127.0.0.1 by default; Caddy terminates TLS in front of both
# (see Caddyfile.example). Publishing them directly means plaintext HTTP —
# WebDAV would put its password on the wire in clear.
# APP_HOST=0.0.0.0
# WEBDAV_HOST=0.0.0.0
#
# Pin sessions across container rebuilds. Generated into data/ when unset.
# SESSION_SECRET=<64 hex chars>
#
# Trusted reverse-proxy hops in front of the app (default 1 = a single Caddy).
# Per-IP lockouts read this many X-Forwarded-For entries from the right; raise
# it only if another proxy (e.g. Cloudflare) sits in front of Caddy.
#
# Set 0 only when the app port is published with no proxy at all. Nothing in
# the header is trustworthy then, so every client keys to one shared bucket:
# forged headers cannot mint fresh identities, but one noisy client throttles
# everyone. Keeping the loopback default and letting Caddy front the app is
# the better answer.
# TRUSTED_PROXY_HOPS=1
#
# For a custom public domain, follow docs/public-exposure.md:
# PAPERNOOK_PUBLIC_HOST=papernook.example.com
# PAPERNOOK_WEBDAV_URL=https://dav-papernook.example.com

# iCloud share link of the prebuilt capture Shortcut (see docs/shortcut.md)
# PAPERNOOK_SHORTCUT_URL=https://www.icloud.com/shortcuts/...

# Chrome Web Store publishing (used only by `npm run release:chrome`). The
# first submission is manual; the item ID below was assigned by Google and is
# public. The three OAuth values are secrets — mint them for the Chrome Web
# Store API against the publisher account and keep them out of the repo.
# EXTENSION_ID=cglnjlhkdgahafajfimnaonnlapecpfh
# CLIENT_ID=
# CLIENT_SECRET=
# REFRESH_TOKEN=
