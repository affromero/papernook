{
  "name": "papernook",
  "version": "0.1.0",
  "private": true,
  "description": "A self-hosted paper library for capture, annotation, and AI-assisted reading.",
  "homepage": "https://github.com/affromero/papernook#readme",
  "bugs": {
    "url": "https://github.com/affromero/papernook/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/affromero/papernook.git"
  },
  "license": "MIT",
  "author": "Andres Romero <me@afromero.co>",
  "scripts": {
    "build": "next build && node scripts/prepare-runtime.mjs && node scripts/assert-standalone-safe.mjs",
    "build:chrome": "node scripts/extension/build-chrome.mjs",
    "build:safari": "./scripts/build-safari.sh",
    "ci": "npm run lint && npm run format:check && npm run typecheck && npm run test && npm run build",
    "dev": "next dev",
    "format:check": "prettier --check .",
    "postinstall": "node scripts/patch-tldraw-font-manager.mjs && (cp node_modules/thesidedoor/src/pwa/sw.js public/sw.js || true) && (node scripts/vendor-three.mjs || true)",
    "lint": "eslint",
    "release:chrome": "npm run build:chrome && chrome-webstore-upload --source build/papernook-chrome.zip",
    "screenshots": "playwright test --update-snapshots",
    "start": "next start",
    "test": "vitest run",
    "test:chrome": "npm run build:chrome && node tests/chrome.e2e.mjs",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --max-warnings 0"
    ],
    "*.{ts,tsx,js,jsx,json,md,css,yaml,yml}": [
      "prettier --write"
    ],
    "package.json": [
      "sort-package-json"
    ]
  },
  "overrides": {
    "postcss": "^8.5.17"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "@citation-js/core": "^0.8.2",
    "@citation-js/plugin-bibtex": "^0.8.2",
    "@citation-js/plugin-csl": "^0.8.2",
    "@citation-js/plugin-ris": "^0.8.2",
    "better-sqlite3": "^13.0.3",
    "chokidar": "^5.0.0",
    "cytoscape": "^3.34.0",
    "cytoscape-fcose": "^2.2.0",
    "html-to-text": "^9.0.5",
    "katex": "^0.18.2",
    "lucide-react": "^1.30.0",
    "next": "16.3.0",
    "openai": "^7.4.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.1.200",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "thesidedoor": "^0.1.0",
    "three": "^0.185.1",
    "tldraw": "^5.3.0",
    "undici": "^8.10.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cytoscape": "^3.31.0",
    "@types/html-to-text": "^9.0.4",
    "@types/node": "^26.2.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.5",
    "chrome-webstore-upload-cli": "4.0.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.0",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "sort-package-json": "^4.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22"
  }
}
