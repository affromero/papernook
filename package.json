{
  "name": "papernook",
  "version": "0.1.0",
  "private": true,
  "description": "A self-hosted paper library for capture, annotation, and AI-assisted reading.",
  "homepage": "https://github.com/affromero/papernook#readme",
  "bugs": {
    "url": "https://github.com/affromero/papernook/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/affromero/papernook.git"
  },
  "license": "MIT",
  "author": "Andres Romero <me@afromero.co>",
  "scripts": {
    "build": "next build && node scripts/prepare-runtime.mjs && node scripts/assert-standalone-safe.mjs",
    "ci": "npm run lint && npm run typecheck && npm run test && npm run build",
    "dev": "next dev",
    "format:check": "prettier --check .",
    "postinstall": "node scripts/patch-tldraw-font-manager.mjs && (cp node_modules/thesidedoor/src/pwa/sw.js public/sw.js || true)",
    "lint": "eslint",
    "screenshots": "playwright test --update-snapshots",
    "start": "next start",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --max-warnings 0"
    ],
    "*.{ts,tsx,js,jsx,json,md,css,yaml,yml}": [
      "prettier --write"
    ],
    "package.json": [
      "sort-package-json"
    ]
  },
  "overrides": {
    "postcss": "^8.5.17"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.111.0",
    "@citation-js/core": "^0.8.1",
    "@citation-js/plugin-bibtex": "^0.8.1",
    "@citation-js/plugin-csl": "^0.8.1",
    "@citation-js/plugin-ris": "^0.8.1",
    "better-sqlite3": "^12.11.1",
    "chokidar": "^5.0.0",
    "cytoscape": "^3.34.0",
    "cytoscape-fcose": "^2.2.0",
    "lucide-react": "^1.24.0",
    "next": "16.2.11",
    "openai": "^6.46.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.1.200",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "thesidedoor": "^0.1.0",
    "tldraw": "^5.2.4",
    "undici": "^8.7.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cytoscape": "^3.21.9",
    "@types/node": "^26.1.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.10",
    "lint-staged": "^17.0.8",
    "prettier": "^3.9.5",
    "sort-package-json": "^4.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22"
  }
}
